# Groq API Key — requerida para Domex AI y funciones inteligentes.
# Obtené tu key gratis en https://console.groq.com (14.400 requests/día)
VITE_GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxx"

# NewsAPI Key — opcional, para Intel Feed con noticias reales.
# Gratis en https://newsapi.org/register (sin key usa datos mock)
VITE_NEWS_API_KEY=""

# PostHog Analytics — opcional. Sin key, no trackea nada (no rompe la app).
# 1. Crear cuenta gratis en https://app.posthog.com
# 2. Project Settings → Project API Key
# 3. Agregar ambas vars en Vercel → Settings → Environment Variables
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=""
VITE_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
